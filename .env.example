# Cấu hình CSDL PostgreSQL (Bạn hãy copy file này thành .env và điền thông tin thật vào)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rok_db
DB_USER=postgres
DB_PASSWORD=yourpassword

# Khóa bí mật cho Admin (Key mặc định đăng nhập để vào bảng điều khiển)
ADMIN_KEY=ADMIN-ROK-VIP

# API Key để crawl dữ liệu từ YouTube (tạo miễn phí tại Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here
